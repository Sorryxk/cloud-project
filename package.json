{
  "name": "periferia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx src/server/seed.ts",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:worker": "tsx watch src/server/worker-main.ts",
    "dev:web": "vite --config apps/web/vite.config.mts",
    "build": "pnpm generate && tsc -p tsconfig.json && vite build --config apps/web/vite.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test:reservations": "node --test --test-concurrency=1 dist/test/reservations.test.js",
    "start:api": "node dist/server/main.js",
    "start:worker": "node dist/server/worker-main.js",
    "test:http": "node --test --test-concurrency=1 dist/test/http.test.js",
    "format": "prettier --write \"src/**/*.ts\" \"apps/web/src/*\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@11.25.0"
}
