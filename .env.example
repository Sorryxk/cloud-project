NODE_ENV=development
DATABASE_URL=postgresql://periferia:local_only_change_me@localhost:55483/periferia
PORT=3187
WEB_ORIGIN=http://localhost:5187
AI_MODE=mock
BEDROCK_MODEL_ID=global.openai.gpt-6-luna
# Produção: AI_MODE=bedrock e credenciais da IAM Role da task API.
# Para testar Bedrock localmente, remova as credenciais do emulador abaixo
# e use uma sessão AWS autorizada. Nenhuma chave OpenAI é necessária.
AWS_REGION=us-east-2
SQS_ENDPOINT=http://localhost:59324
SQS_QUEUE_URL=http://localhost:59324/000000000000/reservation-events
# Apenas para o emulador local, não são credenciais AWS:
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DATABASE_POOL_MAX=3
WORKER_PORT=3001
