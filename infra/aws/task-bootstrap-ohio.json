{
  "containerDefinitions": [
    {
      "name": "bootstrap",
      "image": "920358117159.dkr.ecr.us-east-2.amazonaws.com/periferia/app@sha256:9c4919a8a8b8ed385f342178dbafa2be32246071338e25da8d818dc406a2b237",
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 512,
      "portMappings": [],
      "essential": true,
      "command": [
        "node",
        "dist/server/migrate.js"
      ],
      "environment": [
