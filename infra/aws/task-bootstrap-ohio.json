          "value": "/app/certs/global-bundle.pem"
        },
        {
          "name": "NODE_EXTRA_CA_CERTS",
          "value": "/app/certs/global-bundle.pem"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DB_HOST",
          "value": "periferia-postgres.c6m5senwl8bz.us-east-2.rds.amazonaws.com"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "ADMIN_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:920358117159:secret:rds!db-0ae0d8f2-83e1-4093-9500-e349eaa31a87-k8hV8Z:username::"
        },
        {
          "name": "ADMIN_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:920358117159:secret:rds!db-0ae0d8f2-83e1-4093-9500-e349eaa31a87-k8hV8Z:password::"
        },
        {
          "name": "API_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:920358117159:secret:periferia/api-db-nQsogX:password::"
        },
        {
          "name": "WORKER_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:920358117159:secret:periferia/worker-db-2bh2d7:password::"
        }
      ],
      "stopTimeout": 120,
      "readonlyRootFilesystem": false,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/periferia/bootstrap",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "family": "periferia-bootstrap",
  "taskRoleArn": "arn:aws:iam::920358117159:role/periferia-bootstrap-task",
  "executionRoleArn": "arn:aws:iam::920358117159:role/periferia-bootstrap-execution",
  "networkMode": "bridge",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
