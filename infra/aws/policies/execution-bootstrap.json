{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:aws:ecr:us-east-2:920358117159:repository/periferia/app"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-2:920358117159:log-group:/periferia/bootstrap:*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-2:920358117159:secret:periferia/api-db-nQsogX",
        "arn:aws:secretsmanager:us-east-2:920358117159:secret:periferia/worker-db-2bh2d7",
        "arn:aws:secretsmanager:us-east-2:920358117159:secret:rds!db-0ae0d8f2-83e1-4093-9500-e349eaa31a87-k8hV8Z"
      ]
    }
  ]
}
