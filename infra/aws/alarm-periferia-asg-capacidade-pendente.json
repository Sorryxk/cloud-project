{
  "AlarmName": "periferia-asg-capacidade-pendente",
  "AlarmDescription": "Projeto Periferia; limiar inicial a calibrar com medi\u00e7\u00f5es.",
  "EvaluationPeriods": 5,
  "DatapointsToAlarm": 5,
  "Threshold": 0,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching",
  "AlarmActions": [
    "arn:aws:sns:us-east-2:920358117159:periferia-alertas"
  ],
  "OKActions": [
    "arn:aws:sns:us-east-2:920358117159:periferia-alertas"
  ],
  "Tags": [
    {
      "Key": "Project",
      "Value": "Periferia"
    }
  ],
  "Metrics": [
    {
      "Id": "desired",
      "MetricStat": {
        "Metric": {
          "Namespace": "AWS/AutoScaling",
          "MetricName": "GroupDesiredCapacity",
          "Dimensions": [
            {
              "Name": "AutoScalingGroupName",
              "Value": "periferia-ecs"
            }
          ]
        },
        "Period": 60,
        "Stat": "Average"
      },
      "ReturnData": false
    },
    {
      "Id": "actual",
      "MetricStat": {
        "Metric": {
          "Namespace": "AWS/AutoScaling",
          "MetricName": "GroupInServiceInstances",
          "Dimensions": [
            {
              "Name": "AutoScalingGroupName",
              "Value": "periferia-ecs"
            }
          ]
        },
        "Period": 60,
        "Stat": "Average"
      },
      "ReturnData": false
    },
    {
      "Id": "gap",
      "Expression": "desired - actual",
      "Label": "Inst\u00e2ncias aguardadas",
      "ReturnData": true
    }
  ]
}
