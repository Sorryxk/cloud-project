{
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "920358117159.dkr.ecr.us-east-2.amazonaws.com/periferia/app@sha256:9c4919a8a8b8ed385f342178dbafa2be32246071338e25da8d818dc406a2b237",
      "cpu": 256,
      "memory": 512,
      "memoryReservation": 512,
      "portMappings": [],
      "essential": true,
      "command": [
        "node",
        "dist/server/worker-main.js"
      ],
      "environment": [
        {
          "name": "SERVICE_NAME",
          "value": "worker"
        },
        {
          "name": "DATABASE_POOL_MAX",
          "value": "3"
        },
        {
          "name": "DATABASE_CA_PATH",
          "value": "/app/certs/global-bundle.pem"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "SQS_QUEUE_URL",
          "value": "https://us-east-2.queue.amazonaws.com/920358117159/periferia-reservation-events"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:920358117159:secret:periferia/worker-db-2bh2d7:url::"
        }
      ],
      "stopTimeout": 120,
      "readonlyRootFilesystem": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/periferia/worker",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3001/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    }
  ],
  "family": "periferia-worker",
  "taskRoleArn": "arn:aws:iam::920358117159:role/periferia-worker-task",
  "executionRoleArn": "arn:aws:iam::920358117159:role/periferia-worker-execution",
  "networkMode": "bridge",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "256"
}
